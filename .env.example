# smart-log-analyzer — environment variables
# Copy to .env.local and fill in your values.
# .env.local is gitignored. Never commit real credentials.

# ── Supabase ────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used server-side only (AI pipeline, root actions).
# Never expose to the browser / client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase connection pooler URL (transaction mode, port 6543).
# Found in: Supabase project → Settings → Database → Connection pooling.
# The Supabase JS SDK used throughout the app does NOT need this —
# only required if any code path opens raw Postgres connections
# (e.g. a seed script using node-postgres / postgres.js).
# Never use this from serverless/Edge contexts — use pooler.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres

# Direct Postgres URL (port 5432). Used for migration application (DDL
# operations like CREATE TYPE that don't survive pooler transaction mode).
# Never use from serverless / Edge Function contexts.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

# ── AI Backend ──────────────────────────────────────────────
# Set to 'openrouter' for cloud or 'ollama' for local.
AI_BACKEND=openrouter

# OpenRouter (cloud) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Ollama (local) — run `ollama serve` before starting the app.
# Pull models first: `ollama pull llama3.2 && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
